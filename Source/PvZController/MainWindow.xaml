<Window x:Class="PvZController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PvZ Toolkit AI — StreamToEarn" Width="900" Height="670" MinWidth="780" MinHeight="600"
        Background="#111827" Foreground="#F9FAFB" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#374151"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="PvZ All-in-One Controller"/>
                    <TextBlock Margin="0,5,0,0" Foreground="#9CA3AF" Text="Target: English Origin GOTY 1.2.0.1073"/>
                    <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontWeight="SemiBold" Foreground="#F59E0B" Text="Disconnected"/>
                    <TextBlock x:Name="StateText" Margin="0,4,0,0" Foreground="#D1D5DB" Text="Start PvZ, then connect."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button Content="Connect" Click="Connect_Click"/>
                    <Button Content="Disconnect" Background="#4B5563" Click="Disconnect_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="Resources">
                <StackPanel>
                    <TextBlock Text="Sun" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="SunInput" Width="130" Text="500"/>
                        <Button Content="Set Sun" Click="SetSun_Click"/>
                        <Button Content="Read" Background="#4B5563" Click="Refresh_Click"/>
                    </StackPanel>
                    <CheckBox x:Name="AutoCollectCheck" IsChecked="True" IsEnabled="False" Margin="0,14,0,4" Content="Auto-collect sun and coins (always on)"/>
                    <TextBlock Margin="0,4,0,0" Foreground="#9CA3AF" Text="Bot maintains 5,000,000 sun."/>
                    <TextBlock Margin="0,4,0,0" Foreground="#9CA3AF" Text="Background play enabled: Alt+Tab will not pause."/>
                    <CheckBox x:Name="FreePlantingCheck" Margin="0,5,0,0" Content="Free planting" Click="FreePlanting_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="Bot control">
                <StackPanel>
                    <TextBlock x:Name="BotStateText" Text="Bot: stopped" Margin="0,0,0,10"/>
                    <CheckBox x:Name="AutoChooseCheck" IsChecked="True" Margin="0,0,0,10" Content="Auto-start with virtual all-plant arsenal"/>
                    <CheckBox x:Name="VoiceCheck" IsChecked="True" Margin="0,0,0,10" Content="Bot voice (free local speech)"/>
                    <CheckBox x:Name="ContinuousEndlessCheck" IsChecked="True" Margin="0,0,0,10" Content="Uninterrupted Day: one endless battle (no chooser / no flags)"/>
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                        <Button Content="Start" Click="BotStart_Click"/>
                        <Button Content="Pause" Background="#D97706" Click="BotPause_Click"/>
                        <Button Content="Stop" Background="#4B5563" Click="BotStop_Click"/>
                    </StackPanel>
                    <TextBlock Margin="0,10,0,0" Foreground="#9CA3AF" TextWrapping="Wrap" Text="Day battles hide seed bank/shovel and wave meter. Bot uses virtual cooldowns."/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Battlefield placement">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Plant" Margin="0,0,0,5"/>
                    <ComboBox x:Name="PlantChoice" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedIndex="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Zombie" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ZombieChoice" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedIndex="0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Row" Margin="0,0,0,5"/>
                    <ComboBox x:Name="RowChoice" Width="78" SelectedIndex="0">
                        <ComboBoxItem Content="1" Tag="0"/><ComboBoxItem Content="2" Tag="1"/>
                        <ComboBoxItem Content="3" Tag="2"/><ComboBoxItem Content="4" Tag="3"/>
                        <ComboBoxItem Content="5" Tag="4"/><ComboBoxItem Content="6" Tag="5"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Column" Margin="0,0,0,5"/>
                    <ComboBox x:Name="ColumnChoice" Width="78" SelectedIndex="0">
                        <ComboBoxItem Content="1" Tag="0"/><ComboBoxItem Content="2" Tag="1"/>
                        <ComboBoxItem Content="3" Tag="2"/><ComboBoxItem Content="4" Tag="3"/>
                        <ComboBoxItem Content="5" Tag="4"/><ComboBoxItem Content="6" Tag="5"/>
                        <ComboBoxItem Content="7" Tag="6"/><ComboBoxItem Content="8" Tag="7"/>
                        <ComboBoxItem Content="9" Tag="8"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button Content="Place Plant" Click="PlacePlant_Click"/>
                    <Button Content="Spawn Zombie" Background="#7C3AED" Margin="0,8,8,0" Click="SpawnZombie_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Border Grid.Row="3" Background="#7F1D1D" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <Grid>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Emergency stop disables controller patches and disconnects from PvZ."/>
                <Button HorizontalAlignment="Right" Content="EMERGENCY STOP" Background="#DC2626" FontWeight="Bold" Click="EmergencyStop_Click"/>
            </Grid>
        </Border>

        <GroupBox Grid.Row="4" Header="Action log" Margin="0">
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" Background="#0B1220"/>
        </GroupBox>
    </Grid>
</Window>
